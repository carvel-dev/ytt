  type: ClusterIP
#@ end

#@ def test2_right():
#@overlay/match by=overlay.map_key("kind")
---
kind: Service
#@overlay/match missing_ok=True
spec:
  type: ClusterIP
#@ end

---
test1
--- #@ template.replace(overlay.apply(test1_left(), test1_right()))
---
test2
--- #@ template.replace(overlay.apply(test1_left(), test2_right()))

